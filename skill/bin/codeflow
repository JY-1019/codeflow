#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path


def installed_app_executable() -> Path | None:
    configured = os.environ.get("CODEFLOW_APP_EXECUTABLE", "").strip()
    if configured:
        path = Path(configured).expanduser()
        if path.exists():
            return path.resolve()
        raise RuntimeError(f"CODEFLOW_APP_EXECUTABLE does not exist: {path}")

    if sys.platform == "darwin":
        candidates = [
            Path("/Applications/Codeflow.app/Contents/MacOS/Codeflow"),
            Path.home() / "Applications" / "Codeflow.app" / "Contents" / "MacOS" / "Codeflow",
        ]
    elif os.name == "nt":
        candidates = [
            Path(os.environ.get("LOCALAPPDATA", "")) / "Programs" / "Codeflow" / "Codeflow.exe",
            Path(os.environ.get("PROGRAMFILES", "")) / "Codeflow" / "Codeflow.exe",
            Path(os.environ.get("PROGRAMFILES(X86)", "")) / "Codeflow" / "Codeflow.exe",
            Path.cwd() / "Codeflow-0.2.0-x64.exe",
            Path.cwd() / "Codeflow.exe",
        ]
    else:
        candidates = []

    for candidate in candidates:
        if candidate.exists():
            return candidate.resolve()
    return None


def repo_root() -> Path:
    configured = os.environ.get("CODEFLOW_APP_ROOT", "").strip()
    if configured:
        return Path(configured).expanduser().resolve()

    script_path = Path(__file__).resolve()
    for start in [script_path.parent, Path.cwd().resolve()]:
        for candidate in [start, *start.parents]:
            if (candidate / "frontend" / "package.json").exists() and (candidate / "backend" / "main.py").exists():
                return candidate

    raise RuntimeError(
        "Could not find Codeflow app root. Set CODEFLOW_APP_ROOT to the repository path."
    )


def frontend_dir() -> Path:
    return repo_root() / "frontend"


def run(cmd: list[str], cwd: Path, env: dict[str, str] | None = None) -> None:
    subprocess.run(cmd, cwd=str(cwd), env=env, check=True)


def ensure_frontend_ready() -> None:
    frontend = frontend_dir()
    if not (frontend / "node_modules" / "electron").exists():
        run(["npm", "install"], frontend)

    dist_index = frontend / "dist" / "index.html"
    if not dist_index.exists() or sources_newer_than(dist_index):
        run(["npm", "run", "build"], frontend)


def sources_newer_than(target: Path) -> bool:
    watched = [
        frontend_dir() / "src",
        frontend_dir() / "electron",
        frontend_dir() / "package.json",
        frontend_dir() / "vite.config.ts",
    ]
    target_mtime = target.stat().st_mtime
    for root in watched:
        if root.is_file() and root.stat().st_mtime > target_mtime:
            return True
        if root.is_dir():
            for path in root.rglob("*"):
                if path.is_file() and path.stat().st_mtime > target_mtime:
                    return True
    return False


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Launch or focus the Codeflow desktop app.")
    parser.add_argument("--project-root", default=os.environ.get("CODEFLOW_PROJECT_ROOT", ""))
    parser.add_argument("--session-id", default=os.environ.get("CODEFLOW_SESSION_ID", ""))
    parser.add_argument("--session-title", default=os.environ.get("CODEFLOW_SESSION_TITLE", ""))
    parser.add_argument("--prepare-only", action="store_true", help="Install/build if needed, then exit.")
    parser.add_argument("--no-build", action="store_true", help="Skip dependency install/build checks.")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    project_root = str(Path(args.project_root or os.environ.get("PWD", ".")).expanduser().resolve())

    env = {
        **os.environ,
        "CODEFLOW_PROJECT_ROOT": project_root,
    }
    if args.session_id:
        env["CODEFLOW_SESSION_ID"] = args.session_id
    if args.session_title:
        env["CODEFLOW_SESSION_TITLE"] = args.session_title

    installed_app = installed_app_executable()
    if installed_app:
        if args.prepare_only:
            return 0
        os.execvpe(str(installed_app), [str(installed_app)], env)
        return 127

    if os.environ.get("CODEFLOW_ALLOW_DEV_LAUNCH", "").strip() != "1":
        raise RuntimeError(
            "Codeflow installed app was not found. Install Codeflow.app in /Applications "
            "or set CODEFLOW_APP_EXECUTABLE to the packaged app/EXE path. "
            "Set CODEFLOW_ALLOW_DEV_LAUNCH=1 only for repository-local development."
        )

    root = repo_root()
    env["CODEFLOW_APP_ROOT"] = str(root)
    if not args.no_build:
        ensure_frontend_ready()
    if args.prepare_only:
        return 0

    os.chdir(frontend_dir())
    os.execvpe("npm", ["npm", "run", "electron"], env)
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
